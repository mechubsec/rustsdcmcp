[Unit]
Description=Security Director Cloud MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rustsdcmcp
Group=rustsdcmcp
EnvironmentFile=/etc/rustsdcmcp/credentials.env
Environment=RUST_LOG=info
ExecStart=/usr/local/bin/rustsdcmcp \
    --device-mapping /etc/rustsdcmcp/sdc.json \
    --transport streamable-http \
    --host 127.0.0.1 \
    --port 30032 \
    --tokens-file /var/lib/rustsdcmcp/tokens.json \
    --audit-format json \
    --audit-journald \
    --audit-log-file $STATE_DIRECTORY/audit.jsonl \
    --audit-redact devices=hmac \
    --audit-hmac-key-file /etc/rustsdcmcp/audit-hmac.key
ExecReload=/bin/kill -HUP $MAINPID
# SIGHUP is the token/audit reload path; restart if it arrives during startup.
Restart=always
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077
StateDirectory=rustsdcmcp
StateDirectoryMode=0700
RuntimeDirectory=rustsdcmcp
RuntimeDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/rustsdcmcp
ReadWritePaths=/var/lib/rustsdcmcp
PrivateTmp=true
PrivateDevices=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Egress policy -- DEFENCE IN DEPTH ONLY. Read this before relying on it.
#
# systemd implements IPAddress* with cgroup eBPF. An unprivileged LXC -- the
# deployment target recommended in README.md -- usually cannot attach those
# programs without host delegation, and systemd then FAILS OPEN: it logs a
# warning and runs the unit with no filter at all. `systemd-analyze security`
# cannot detect this; it only scores the declaration. The installer probes
# actual enforcement and reports which case you are in.
#
# Where it does attach (VM, bare metal, privileged container) this denies the
# cloud metadata endpoints and IPv6 link-local -- none is ever a legitimate
# resolver, so the default is safe to ship anywhere.
#
# fd00:ec2::254 is denied as a single /128 rather than via fc00::/7. IPv6 IMDS
# lives inside the ULA range, so dropping the whole range would have left the
# credential endpoint reachable, but denying all of fc00::/7 would break any
# site whose resolver is ULA-addressed. The host route is the precise fix.
#
# RFC1918 ranges are deliberately NOT denied by default: this package installs
# on networks whose resolver may live in any of them, and denying the resolver
# stops the service resolving the SDC endpoint at all. docs/operations.md has
# the opt-in drop-in that adds them alongside an explicit resolver allow.
#
# A strict IPAddressDeny=any allowlist is not viable either way: the SDC API is
# a cloud address whose IPs rotate.
IPAddressAllow=localhost
IPAddressDeny=169.254.0.0/16 fe80::/10 fd00:ec2::254/128
# Makes enforcement observable: the byte counters below are populated only when
# the BPF program actually attached. `[no data]` means the filters are inert.
IPAccounting=yes
SystemCallArchitectures=native
# Without SystemCallErrorNumber=EPERM systemd's default raises SIGSYS and kills
# the process mid-request, which is what happened to rustunifimcp during a
# change-set state write (mecmcp#351). This server was NOT affected precisely
# because it already sets EPERM. An EPERM denial is silent at the systemd layer;
# the only place it can become visible is the application, which must stop
# discarding the errno.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @obsolete @mount @swap @reboot @module
SystemCallErrorNumber=EPERM
TasksMax=256
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
